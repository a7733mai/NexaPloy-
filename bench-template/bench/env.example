# Nexaploy bench .env  (/opt/nexaploy/benches/<bench>/.env)
# Written by the agent on bench.create; read by Docker Compose for ${VAR}
# interpolation in docker-compose.yml. See ARCHITECTURE.md §3.1.

# --- required (ARCHITECTURE.md §3.1) ---------------------------------------
BENCH_NAME=erp-v15-main
IMAGE=nexaploy/bench:erp-v15-main-20261103T2130
FRAPPE_UID=3113
FRAPPE_GID=3113
REDIS_UID=3102
REDIS_GID=3102
TZ=Asia/Qatar
DB_HOST=nexaploy-db
DB_PORT=3306
BACKEND_WORKERS=2
BACKEND_CPUS=2
BACKEND_MEM=4G

# --- optional (defaults shown) ----------------------------------------------
# Compose project name; the rendered file also sets `name:` to the bench.
# COMPOSE_PROJECT_NAME=erp-v15-main

# Background workers (queue-short/long/default) and the configurator.
WORKER_CPUS=1
WORKER_MEM=1G
# SCHEDULER_CPUS=0.5
# SCHEDULER_MEM=512M
# FRONTEND_CPUS=1
# FRONTEND_MEM=512M
# WEBSOCKET_CPUS=0.5
# WEBSOCKET_MEM=512M
# REDIS_IMAGE=redis:7-alpine
# REDIS_CPUS=0.5
# REDIS_CACHE_MEM=512M
# REDIS_CACHE_MAXMEMORY=256mb
# REDIS_QUEUE_MEM=512M

# nginx (frontend). Traefik reaches the frontend over proxy-network, so trust
# X-Forwarded-For from Docker's private ranges.
# UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12
# UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
# UPSTREAM_REAL_IP_RECURSIVE=on
# PROXY_READ_TIMEOUT=120
# CLIENT_MAX_BODY_SIZE=50m

# ./sites mount propagation. The agent sets rslave when a site's files are offloaded to
# object storage (rclone mounts on the host, ARCHITECTURE.md section 11). Needs a shared host mount.
# SITES_PROPAGATION=rprivate
