{#-
  Nexaploy bench compose template (ARCHITECTURE.md §3).

  Rendered by the agent into /opt/nexaploy/benches/<bench>/docker-compose.yml.

  Jinja context (StrictUndefined-safe):
    bench   (required)  bench name, ^[a-z][a-z0-9-]{2,30}$ — used for container,
                        network and redis host names (structure, not values).
  Every other value (image, UIDs, TZ, DB host/port, limits, ...) is read by
  Docker Compose from the bench .env via ${VAR} interpolation, so changing
  .env + `docker compose up -d` is enough; no re-render needed. Extra context
  keys (image, frappe_uid, ...) are accepted and ignored.
-#}
# Generated by the Nexaploy agent from bench-template/bench/docker-compose.yml.j2.
# Bench: {{ bench }} — do not edit by hand; change .env or re-render instead.
name: {{ bench }}

x-logging: &logging
  driver: local
  options:
    max-size: "10m"
    max-file: "3"

x-frappe-hardening: &frappe-hardening
  image: ${IMAGE:?IMAGE must be set in .env}
  user: "${FRAPPE_UID:-3113}:${FRAPPE_GID:-3113}"
  read_only: true
  tmpfs:
    - /tmp:mode=1777,size=256m
    - /home/frappe/.cache:uid=${FRAPPE_UID:-3113},gid=${FRAPPE_GID:-3113},mode=0700,size=64m
  security_opt:
    - no-new-privileges:true
  cap_drop:
    - ALL
  restart: unless-stopped
  logging: *logging

x-frappe-env: &frappe-env
  TZ: ${TZ:-UTC}
  DB_HOST: ${DB_HOST:-nexaploy-db}
  DB_PORT: ${DB_PORT:-3306}

x-worker-limits: &worker-limits
  resources:
    limits:
      cpus: "${WORKER_CPUS:-1}"
      memory: ${WORKER_MEM:-1G}

x-worker-healthcheck: &worker-healthcheck
  # Workers/scheduler expose no port: check they can reach their queue.
  test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/{{ bench }}-redis-queue/6379' || exit 1"]
  interval: 30s
  timeout: 5s
  retries: 3
  start_period: 30s

x-redis-hardening: &redis-hardening
  image: ${REDIS_IMAGE:-redis:7-alpine}
  user: "${REDIS_UID:-3102}:${REDIS_GID:-3102}"
  read_only: true
  tmpfs:
    - /tmp:mode=1777,size=16m
  security_opt:
    - no-new-privileges:true
  cap_drop:
    - ALL
  restart: unless-stopped
  logging: *logging
  networks:
    - bench-net
  healthcheck:
    test: ["CMD", "redis-cli", "ping"]
    interval: 10s
    timeout: 3s
    retries: 5

services:
  # One-shot: writes sites/apps.txt + common_site_config.json. Idempotent.
  # Not started by `up`; the agent runs `docker compose run --rm configurator`.
  configurator:
    <<: *frappe-hardening
    profiles: ["configurator"]
    restart: "no"
    entrypoint: ["bash", "-c"]
    command:
      - >
        set -euo pipefail;
        ls -1 ../apps > apps.txt;
        bench set-config -g db_host "$$DB_HOST";
        bench set-config -gp db_port "$$DB_PORT";
        bench set-config -g redis_cache "redis://{{ bench }}-redis-cache:6379";
        bench set-config -g redis_queue "redis://{{ bench }}-redis-queue:6379";
        bench set-config -g redis_socketio "redis://{{ bench }}-redis-queue:6379";
        bench set-config -gp socketio_port 9000;
        echo "configurator: common_site_config.json updated"
    working_dir: /home/frappe/frappe-bench/sites
    environment:
      <<: *frappe-env
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites
      - ./logs:/home/frappe/frappe-bench/logs
    networks:
      - bench-net
      - nexaploy-db
    deploy:
      <<: *worker-limits

  backend:
    <<: *frappe-hardening
    container_name: {{ bench }}-backend
    command:
      - /home/frappe/frappe-bench/env/bin/gunicorn
      - --chdir=/home/frappe/frappe-bench/sites
      - --bind=0.0.0.0:8000
      - --threads=4
      - --workers=${BACKEND_WORKERS:-2}
      - --worker-class=gthread
      - --worker-tmp-dir=/dev/shm
      - --timeout=120
      - --preload
      - frappe.app:application
    environment:
      <<: *frappe-env
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites
      - ./logs:/home/frappe/frappe-bench/logs
      - assets:/home/frappe/frappe-bench/sites/assets
    networks:
      - bench-net
      - nexaploy-db
    depends_on:
      redis-cache:
        condition: service_healthy
      redis-queue:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/8000' || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    deploy:
      resources:
        limits:
          cpus: "${BACKEND_CPUS:-2}"
          memory: ${BACKEND_MEM:-4G}

  frontend:
    <<: *frappe-hardening
    container_name: {{ bench }}-frontend
    # nginx-entrypoint.sh renders the nginx config at start, so the root fs
    # stays writable here; still non-root, no caps, no-new-privileges.
    read_only: false
    command: ["nginx-entrypoint.sh"]
    environment:
      TZ: ${TZ:-UTC}
      BACKEND: {{ bench }}-backend:8000
      SOCKETIO: {{ bench }}-websocket:9000
      FRAPPE_SITE_NAME_HEADER: $$host
      UPSTREAM_REAL_IP_ADDRESS: ${UPSTREAM_REAL_IP_ADDRESS:-172.16.0.0/12}
      UPSTREAM_REAL_IP_HEADER: ${UPSTREAM_REAL_IP_HEADER:-X-Forwarded-For}
      UPSTREAM_REAL_IP_RECURSIVE: ${UPSTREAM_REAL_IP_RECURSIVE:-on}
      PROXY_READ_TIMEOUT: ${PROXY_READ_TIMEOUT:-120}
      CLIENT_MAX_BODY_SIZE: ${CLIENT_MAX_BODY_SIZE:-50m}
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites:ro
      - assets:/home/frappe/frappe-bench/sites/assets:ro
    networks:
      - bench-net
      - proxy-network
    depends_on:
      backend:
        condition: service_started
      websocket:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/8080' || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    deploy:
      resources:
        limits:
          cpus: "${FRONTEND_CPUS:-1}"
          memory: ${FRONTEND_MEM:-512M}

  websocket:
    <<: *frappe-hardening
    container_name: {{ bench }}-websocket
    command: ["node", "/home/frappe/frappe-bench/apps/frappe/socketio.js"]
    environment:
      TZ: ${TZ:-UTC}
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites
      - ./logs:/home/frappe/frappe-bench/logs
    networks:
      - bench-net
    depends_on:
      redis-queue:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/9000' || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    deploy:
      resources:
        limits:
          cpus: "${WEBSOCKET_CPUS:-0.5}"
          memory: ${WEBSOCKET_MEM:-512M}

  queue-short:
    <<: *frappe-hardening
    container_name: {{ bench }}-queue-short
    command: ["bench", "worker", "--queue", "short"]
    environment:
      <<: *frappe-env
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites
      - ./logs:/home/frappe/frappe-bench/logs
      - assets:/home/frappe/frappe-bench/sites/assets:ro
    networks:
      - bench-net
      - nexaploy-db
    depends_on:
      redis-queue:
        condition: service_healthy
    healthcheck: *worker-healthcheck
    deploy: *worker-limits

  queue-long:
    <<: *frappe-hardening
    container_name: {{ bench }}-queue-long
    command: ["bench", "worker", "--queue", "long"]
    environment:
      <<: *frappe-env
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites
      - ./logs:/home/frappe/frappe-bench/logs
      - assets:/home/frappe/frappe-bench/sites/assets:ro
    networks:
      - bench-net
      - nexaploy-db
    depends_on:
      redis-queue:
        condition: service_healthy
    healthcheck: *worker-healthcheck
    deploy: *worker-limits

  queue-default:
    <<: *frappe-hardening
    container_name: {{ bench }}-queue-default
    command: ["bench", "worker", "--queue", "default"]
    environment:
      <<: *frappe-env
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites
      - ./logs:/home/frappe/frappe-bench/logs
      - assets:/home/frappe/frappe-bench/sites/assets:ro
    networks:
      - bench-net
      - nexaploy-db
    depends_on:
      redis-queue:
        condition: service_healthy
    healthcheck: *worker-healthcheck
    deploy: *worker-limits

  scheduler:
    <<: *frappe-hardening
    container_name: {{ bench }}-scheduler
    command: ["bench", "schedule"]
    environment:
      <<: *frappe-env
    volumes:
      - ./sites:/home/frappe/frappe-bench/sites
      - ./logs:/home/frappe/frappe-bench/logs
      - assets:/home/frappe/frappe-bench/sites/assets:ro
    networks:
      - bench-net
      - nexaploy-db
    depends_on:
      redis-queue:
        condition: service_healthy
    healthcheck: *worker-healthcheck
    deploy:
      resources:
        limits:
          cpus: "${SCHEDULER_CPUS:-0.5}"
          memory: ${SCHEDULER_MEM:-512M}

  redis-cache:
    <<: *redis-hardening
    container_name: {{ bench }}-redis-cache
    # Pure cache: no persistence, LRU eviction.
    command:
      - redis-server
      - --save
      - ""
      - --appendonly
      - "no"
      - --maxmemory
      - ${REDIS_CACHE_MAXMEMORY:-256mb}
      - --maxmemory-policy
      - allkeys-lru
    deploy:
      resources:
        limits:
          cpus: "${REDIS_CPUS:-0.5}"
          memory: ${REDIS_CACHE_MEM:-512M}

  redis-queue:
    <<: *redis-hardening
    container_name: {{ bench }}-redis-queue
    # Job queue + socketio pub/sub: AOF persistence. ./redis-queue must be
    # owned by REDIS_UID:REDIS_GID (the agent creates it).
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --save
      - ""
      - --dir
      - /data
    volumes:
      - ./redis-queue:/data
    deploy:
      resources:
        limits:
          cpus: "${REDIS_CPUS:-0.5}"
          memory: ${REDIS_QUEUE_MEM:-512M}

volumes:
  # Built assets (sites/assets) are baked into the image under the sites dir,
  # which ./sites hides. This named volume is seeded from the image on first
  # creation; on image update it must be removed so it is re-seeded
  # (`docker compose down && docker volume rm {{ bench }}_assets`).
  assets: {}

networks:
  bench-net:
    name: {{ bench }}-net
    internal: true
  proxy-network:
    name: proxy-network
    external: true
  nexaploy-db:
    name: nexaploy-db
    external: true
