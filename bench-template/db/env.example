# Nexaploy shared MariaDB stack .env  (/opt/nexaploy/db/.env)
# Compose project "nexaploy-db". See ARCHITECTURE.md §3.4.
#
# The root password is NOT kept here. It lives in /opt/nexaploy/config/db.env
# (mode 600, generated by install.sh) as:
#     DB_ROOT_PASSWORD=<random>
# and is loaded with env_file + mapped to MARIADB_ROOT_PASSWORD at start.

COMPOSE_PROJECT_NAME=nexaploy-db

# InnoDB buffer pool (size to ~50-70% of RAM reserved for MariaDB).
DB_BUFFER_POOL=1G

# Slow query log threshold in seconds (data/slow.log; shown per site in the portal).
DB_LONG_QUERY_TIME=1

# Binary log (point-in-time recovery). Local files are kept this long (default 7 days);
# closed files are also archived to the backup remote every 15 minutes
# (agent job server.archive_binlogs). Keep >= the PITR window offered to customers.
DB_BINLOG_EXPIRE_SECONDS=604800
DB_MAX_BINLOG_SIZE=100M
# 1 = fsync the binlog on every commit (no committed transaction is missing from the
# binlog after a crash). 0 is faster but may lose the last transactions for PITR.
DB_SYNC_BINLOG=1
# Unique per server only if servers ever replicate to each other.
DB_SERVER_ID=1

# Override only for testing; production uses the default path.
# DB_ENV_FILE=/opt/nexaploy/config/db.env
# DB_CPUS=2
# DB_MEM=2G
