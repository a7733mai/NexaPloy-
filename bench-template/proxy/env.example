# Nexaploy proxy stack .env  (/opt/nexaploy/proxy/.env)
# Compose project "nexaploy-proxy". See ARCHITECTURE.md §3.3.

COMPOSE_PROJECT_NAME=nexaploy-proxy

# Let's Encrypt account e-mail (install.sh --acme-email).
ACME_EMAIL=admin@example.com
# Set to https://acme-staging-v02.api.letsencrypt.org/directory while testing.
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Host ports published for the web/websecure entrypoints.
HTTP_PORT=80
HTTPS_PORT=443

# TRAEFIK_IMAGE=traefik:v3.3
# TRAEFIK_LOG_LEVEL=INFO
# TRAEFIK_CPUS=1
# TRAEFIK_MEM=512M

# Optional CrowdSec log analyser (reads ./logs/access.log):
# COMPOSE_PROFILES=crowdsec
# CROWDSEC_COLLECTIONS=crowdsecurity/traefik crowdsecurity/http-cve
