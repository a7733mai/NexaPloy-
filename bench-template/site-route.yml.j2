{#-
  Traefik file-provider route for one site (ARCHITECTURE.md §3.2).
  Rendered by the agent to /opt/nexaploy/proxy/config/sites/<site>.yml.

  Context: site (primary host), domains (list of all hosts incl. primary),
           bench (bench name). The primary is always included even if the
           caller forgot it; duplicates are dropped, order is preserved.
  HTTP (:80) is redirected to websecure globally.

  One router PER HOST (primary: `site-<slug>`, custom domains:
  `site-<slug>--<host slug>`), all sharing the service and middlewares. Traefik
  derives the ACME order from the router rule, so a single `Host(a) || Host(b)`
  router would put every host into ONE certificate: a custom domain whose DNS
  is wrong (or later moved away) would then block issuance/renewal for the
  primary hostname too. Separate routers give each host its own certificate.
  Frappe picks the site from X-Frappe-Site-Name (set here, overriding anything a
  client sends), so custom domains reach the right site without per-domain dirs.
-#}
{%- set slug = site | replace('.', '-') -%}
{%- set hosts = ([site] + (domains | list)) | unique | list -%}
# Generated by the Nexaploy agent — do not edit. Site: {{ site }}  Bench: {{ bench }}
http:
  routers:
{%- for h in hosts %}
    site-{{ slug }}{% if not loop.first %}--{{ h | replace('.', '-') }}{% endif %}:
      rule: "Host(`{{ h }}`)"
      entryPoints:
        - websecure
      service: svc-{{ slug }}
      middlewares:
        - site-{{ slug }}-name@file
        - security-headers@file
        - compress@file
      tls:
        certResolver: letsencrypt
{%- endfor %}
  middlewares:
    site-{{ slug }}-name:
      headers:
        customRequestHeaders:
          X-Frappe-Site-Name: "{{ site }}"
  services:
    svc-{{ slug }}:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://{{ bench }}-frontend:8080"
