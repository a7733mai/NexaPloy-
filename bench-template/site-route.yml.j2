{#-
  Traefik file-provider route for one site (ARCHITECTURE.md §3.2).
  Rendered by the agent to /opt/nexaploy/proxy/config/sites/<site>.yml.

  Context: site (primary host), domains (list of all hosts incl. primary),
           bench (bench name). The primary is always included even if the
           caller forgot it; duplicates are dropped, order is preserved.
  HTTP (:80) is redirected to websecure globally, so only one router.
-#}
{%- set slug = site | replace('.', '-') -%}
{%- set hosts = ([site] + (domains | list)) | unique | list -%}
# Generated by the Nexaploy agent — do not edit. Site: {{ site }}  Bench: {{ bench }}
http:
  routers:
    site-{{ slug }}:
      rule: "{% for h in hosts %}Host(`{{ h }}`){% if not loop.last %} || {% endif %}{% endfor %}"
      entryPoints:
        - websecure
      service: svc-{{ slug }}
      middlewares:
        - security-headers@file
        - compress@file
      tls:
        certResolver: letsencrypt
  services:
    svc-{{ slug }}:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://{{ bench }}-frontend:8080"
